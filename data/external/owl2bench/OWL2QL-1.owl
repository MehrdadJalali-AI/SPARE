@prefix : <http://benchmark/OWL2Bench#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://benchmark/OWL2Bench#> .

<http://benchmark/OWL2Bench> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://benchmark/OWL2Bench#dislikes
:dislikes rdf:type owl:ObjectProperty ;
          rdfs:domain :Person ;
          rdfs:range :Interest ;
          owl:propertyDisjointWith :likes .


###  http://benchmark/OWL2Bench#enrollFor
:enrollFor rdf:type owl:ObjectProperty .


###  http://benchmark/OWL2Bench#enrollIn
:enrollIn rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :isStudentOf ;
          rdfs:domain :Student ;
          rdfs:range :Department .


###  http://benchmark/OWL2Bench#evaluatedBy
:evaluatedBy rdf:type owl:ObjectProperty ;
             owl:inverseOf :evaluates ;
             rdfs:domain :Person ;
             rdfs:range :EvaluationCommittee .


###  http://benchmark/OWL2Bench#evaluates
:evaluates rdf:type owl:ObjectProperty ;
           rdfs:domain :EvaluationCommittee ;
           rdfs:range :Person .


###  http://benchmark/OWL2Bench#hasAdvisor
:hasAdvisor rdf:type owl:ObjectProperty ;
            owl:equivalentProperty :isAdvisedBy .


###  http://benchmark/OWL2Bench#hasAlumnus
:hasAlumnus rdf:type owl:ObjectProperty ;
            owl:inverseOf :hasDegreeFrom ;
            rdfs:domain :University ;
            rdfs:range :Person .


###  http://benchmark/OWL2Bench#hasAssistantProfessor
:hasAssistantProfessor rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf :hasProfessor ;
                       owl:inverseOf :isAssistantProfessorOf ;
                       rdfs:domain :Department ;
                       rdfs:range :AssistantProfessor .


###  http://benchmark/OWL2Bench#hasAssociateProfessor
:hasAssociateProfessor rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf :hasProfessor ;
                       owl:inverseOf :isAssociateProfessorOf ;
                       rdfs:domain :Department ;
                       rdfs:range :AssociateProfessor .


###  http://benchmark/OWL2Bench#hasAuthor
:hasAuthor rdf:type owl:ObjectProperty ;
           rdfs:domain :Publication ;
           rdfs:range :Person ;
           rdfs:comment "publication has author" .


###  http://benchmark/OWL2Bench#hasClericalStaff
:hasClericalStaff rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :hasSupportingStaff ;
                  rdfs:domain :Department ;
                  rdfs:range :ClericalStaff .


###  http://benchmark/OWL2Bench#hasCollaborationWith
:hasCollaborationWith rdf:type owl:ObjectProperty ,
                               owl:SymmetricProperty ,
                               owl:IrreflexiveProperty ;
                      rdfs:domain :Person ;
                      rdfs:range :Person .


###  http://benchmark/OWL2Bench#hasCollege
:hasCollege rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :hasSubOrganization ;
            owl:inverseOf :isCollegeOf ;
            rdfs:domain :University ;
            rdfs:range :College .


###  http://benchmark/OWL2Bench#hasCollegeDiscipline
:hasCollegeDiscipline rdf:type owl:ObjectProperty ;
                      rdfs:domain :College ;
                      rdfs:range :CollegeDiscipline ;
                      owl:propertyDisjointWith :hasMajor .


###  http://benchmark/OWL2Bench#hasCommitteeMembers
:hasCommitteeMembers rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :hasMember ;
                     rdfs:domain :EvaluationCommittee ;
                     rdfs:range :Person .


###  http://benchmark/OWL2Bench#hasDean
:hasDean rdf:type owl:ObjectProperty ;
         owl:inverseOf :isDeanOf ;
         rdfs:domain :Organization ;
         rdfs:range :Person .


###  http://benchmark/OWL2Bench#hasDegreeFrom
:hasDegreeFrom rdf:type owl:ObjectProperty ;
               rdfs:domain :Person ;
               rdfs:range :University .


###  http://benchmark/OWL2Bench#hasDepartment
:hasDepartment rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :hasSubOrganization ;
               owl:inverseOf :isDepartmentOf ;
               rdfs:domain :College ;
               rdfs:range :Department .


###  http://benchmark/OWL2Bench#hasDoctoralDegreeFrom
:hasDoctoralDegreeFrom rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf :hasDegreeFrom ;
                       rdfs:domain :Person ;
                       rdfs:range :University .


###  http://benchmark/OWL2Bench#hasEmployee
:hasEmployee rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :hasMember ;
             owl:inverseOf :worksFor .


###  http://benchmark/OWL2Bench#hasEmployeeEvaluationCommittee
:hasEmployeeEvaluationCommittee rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf :hasEvaluationCommittee ;
                                rdfs:domain :Organization ;
                                rdfs:range :EmployeeEvaluationCommittee .


###  http://benchmark/OWL2Bench#hasEvaluationCommittee
:hasEvaluationCommittee rdf:type owl:ObjectProperty ;
                        rdfs:domain :Organization ;
                        rdfs:range :EvaluationCommittee .


###  http://benchmark/OWL2Bench#hasFaculty
:hasFaculty rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :hasEmployee ;
            owl:inverseOf :isFacultyOf ;
            rdfs:domain :Department ;
            rdfs:range :Faculty .


###  http://benchmark/OWL2Bench#hasFullProfessor
:hasFullProfessor rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :hasProfessor ;
                  owl:inverseOf :isFullProfessorOf ;
                  rdfs:domain :Department ;
                  rdfs:range :FullProfessor .


###  http://benchmark/OWL2Bench#hasHead
:hasHead rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf :hasFullProfessor ;
         owl:inverseOf :isHeadOf .


###  http://benchmark/OWL2Bench#hasLecturer
:hasLecturer rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :hasFaculty ;
             owl:inverseOf :isLecturerOf ;
             rdfs:domain :Department ;
             rdfs:range :Lecturer .


###  http://benchmark/OWL2Bench#hasMajor
:hasMajor rdf:type owl:ObjectProperty ;
          rdfs:domain :Person .


###  http://benchmark/OWL2Bench#hasMasterDegreeFrom
:hasMasterDegreeFrom rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :hasDegreeFrom ;
                     rdfs:domain :Person ;
                     rdfs:range :University .


###  http://benchmark/OWL2Bench#hasMember
:hasMember rdf:type owl:ObjectProperty ;
           owl:inverseOf :isMemberOf ;
           rdfs:domain :Organization ;
           rdfs:range :Person .


###  http://benchmark/OWL2Bench#hasOtherStaff
:hasOtherStaff rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :hasSupportingStaff ;
               rdfs:domain :Department ;
               rdfs:range :OtherStaff .


###  http://benchmark/OWL2Bench#hasPGProgram
:hasPGProgram rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :hasProgram ;
              rdfs:domain :Department ;
              rdfs:range :PGProgram .


###  http://benchmark/OWL2Bench#hasPart
:hasPart rdf:type owl:ObjectProperty ;
         owl:equivalentProperty :hasSubOrganization ;
         owl:inverseOf :isPartOf ;
         rdfs:domain :Organization ;
         rdfs:range :Organization .


###  http://benchmark/OWL2Bench#hasPhDProgram
:hasPhDProgram rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :hasProgram ;
               rdfs:domain :Department ;
               rdfs:range :PhDProgram .


###  http://benchmark/OWL2Bench#hasPostDoc
:hasPostDoc rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :hasFaculty ;
            owl:inverseOf :isPostDocOf ;
            rdfs:domain :Department ;
            rdfs:range :PostDoc .


###  http://benchmark/OWL2Bench#hasProfessor
:hasProfessor rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :hasFaculty ;
              owl:inverseOf :isProfessorOf ;
              rdfs:domain :Department ;
              rdfs:range :Professor .


###  http://benchmark/OWL2Bench#hasProgram
:hasProgram rdf:type owl:ObjectProperty ;
            rdfs:domain :Department ;
            rdfs:range :Program .


###  http://benchmark/OWL2Bench#hasResearchAssistant
:hasResearchAssistant rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :hasEmployee ;
                      owl:inverseOf :isResearchAssistantOf ;
                      rdfs:domain :ResearchGroup ;
                      rdfs:range :ResearchAssistant .


###  http://benchmark/OWL2Bench#hasResearchGroup
:hasResearchGroup rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :hasSubOrganization ;
                  owl:inverseOf :isResearchGroupOf ;
                  rdfs:domain :University ;
                  rdfs:range :ResearchGroup .


###  http://benchmark/OWL2Bench#hasResearchProject
:hasResearchProject rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :hasWork ;
                    rdfs:domain :ResearchGroup ;
                    rdfs:range :ResearchProject .


###  http://benchmark/OWL2Bench#hasSameHomeTownWith
:hasSameHomeTownWith rdf:type owl:ObjectProperty ,
                              owl:SymmetricProperty ,
                              owl:ReflexiveProperty .


###  http://benchmark/OWL2Bench#hasStudent
:hasStudent rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf :hasMember ;
            owl:inverseOf :isStudentOf ;
            rdfs:domain :Organization ;
            rdfs:range :Student .


###  http://benchmark/OWL2Bench#hasStudentEvaluationCommittee
:hasStudentEvaluationCommittee rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf :hasEvaluationCommittee ;
                               rdfs:domain :Organization ;
                               rdfs:range :StudentEvaluationCommittee .


###  http://benchmark/OWL2Bench#hasSubOrganization
:hasSubOrganization rdf:type owl:ObjectProperty ;
                    owl:inverseOf :isSubOrganizationOf ;
                    rdfs:domain :Organization ;
                    rdfs:range :Organization .


###  http://benchmark/OWL2Bench#hasSupportingStaff
:hasSupportingStaff rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :hasEmployee ;
                    rdfs:domain :Department ;
                    rdfs:range :SupportingStaff .


###  http://benchmark/OWL2Bench#hasSystemStaff
:hasSystemStaff rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :hasSupportingStaff ;
                rdfs:domain :Department ;
                rdfs:range :SystemStaff .


###  http://benchmark/OWL2Bench#hasThesisEvaluationCommittee
:hasThesisEvaluationCommittee rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf :hasStudentEvaluationCommittee ;
                              rdfs:domain :Organization ;
                              rdfs:range :ThesisEvaluationCommittee .


###  http://benchmark/OWL2Bench#hasUGProgram
:hasUGProgram rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :hasProgram ;
              rdfs:domain :Department ;
              rdfs:range :UGProgram .


###  http://benchmark/OWL2Bench#hasUndergraduateDegreeFrom
:hasUndergraduateDegreeFrom rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf :hasDegreeFrom ;
                            rdfs:domain :Person ;
                            rdfs:range :University .


###  http://benchmark/OWL2Bench#hasVisitingProfessor
:hasVisitingProfessor rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf :hasProfessor ;
                      owl:inverseOf :isVisitingProfessorOf ;
                      rdfs:domain :Department ;
                      rdfs:range :VisitingProfessor .


###  http://benchmark/OWL2Bench#hasWomenCollege
:hasWomenCollege rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :hasCollege .


###  http://benchmark/OWL2Bench#hasWork
:hasWork rdf:type owl:ObjectProperty ;
         rdfs:domain :Employee ;
         rdfs:range :Work .


###  http://benchmark/OWL2Bench#isAdvisedBy
:isAdvisedBy rdf:type owl:ObjectProperty ;
             rdfs:domain :Person ;
             rdfs:range :Professor .


###  http://benchmark/OWL2Bench#isAffiliateOf
:isAffiliateOf rdf:type owl:ObjectProperty .


###  http://benchmark/OWL2Bench#isAffiliatedOrganizationOf
:isAffiliatedOrganizationOf rdf:type owl:ObjectProperty ,
                                     owl:AsymmetricProperty ,
                                     owl:IrreflexiveProperty ;
                            rdfs:domain :Organization ;
                            rdfs:range :Organization .


###  http://benchmark/OWL2Bench#isAssistantProfessorOf
:isAssistantProfessorOf rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf :isProfessorOf .


###  http://benchmark/OWL2Bench#isAssociateProfessorOf
:isAssociateProfessorOf rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf :isProfessorOf .


###  http://benchmark/OWL2Bench#isClericalStaffOf
:isClericalStaffOf rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :isSupportingStaffOf .


###  http://benchmark/OWL2Bench#isCollegeOf
:isCollegeOf rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :isSubOrganizationOf ;
             rdfs:domain :College ;
             rdfs:range :University .


###  http://benchmark/OWL2Bench#isCrazyAbout
:isCrazyAbout rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :loves ;
              rdfs:domain :Person ;
              rdfs:range :Interest .


###  http://benchmark/OWL2Bench#isDeanOf
:isDeanOf rdf:type owl:ObjectProperty ;
          rdfs:domain :Person ;
          rdfs:range :Organization .


###  http://benchmark/OWL2Bench#isDepartmentOf
:isDepartmentOf rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :isSubOrganizationOf ;
                rdfs:domain :Department ;
                rdfs:range :College .


###  http://benchmark/OWL2Bench#isFacultyOf
:isFacultyOf rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :worksFor ;
             rdfs:domain :Faculty ;
             rdfs:range :Organization .


###  http://benchmark/OWL2Bench#isFullProfessorOf
:isFullProfessorOf rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :isProfessorOf .


###  http://benchmark/OWL2Bench#isHeadOf
:isHeadOf rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :isFullProfessorOf .


###  http://benchmark/OWL2Bench#isLecturerOf
:isLecturerOf rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :isFacultyOf .


###  http://benchmark/OWL2Bench#isMemberOf
:isMemberOf rdf:type owl:ObjectProperty ;
            rdfs:domain :Person ;
            rdfs:range :Organization .


###  http://benchmark/OWL2Bench#isOtherStaffOf
:isOtherStaffOf rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :isSupportingStaffOf .


###  http://benchmark/OWL2Bench#isPartOf
:isPartOf rdf:type owl:ObjectProperty ;
          owl:equivalentProperty :isSubOrganizationOf ;
          rdfs:domain :Organization ;
          rdfs:range :Organization .


###  http://benchmark/OWL2Bench#isPostDocOf
:isPostDocOf rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :isFacultyOf .


###  http://benchmark/OWL2Bench#isProfessorOf
:isProfessorOf rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :isFacultyOf .


###  http://benchmark/OWL2Bench#isResearchAssistantOf
:isResearchAssistantOf rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf :worksFor .


###  http://benchmark/OWL2Bench#isResearchGroupOf
:isResearchGroupOf rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :isSubOrganizationOf ;
                   rdfs:domain :ResearchGroup ;
                   rdfs:range :University .


###  http://benchmark/OWL2Bench#isStudentOf
:isStudentOf rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :isMemberOf ;
             rdfs:domain :Student ;
             rdfs:range :Organization .


###  http://benchmark/OWL2Bench#isSubOrganizationOf
:isSubOrganizationOf rdf:type owl:ObjectProperty ;
                     rdfs:domain :Organization ;
                     rdfs:range :Organization .


###  http://benchmark/OWL2Bench#isSupportingStaffOf
:isSupportingStaffOf rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :worksFor .


###  http://benchmark/OWL2Bench#isSystemStaffOf
:isSystemStaffOf rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :isSupportingStaffOf .


###  http://benchmark/OWL2Bench#isTaughtBy
:isTaughtBy rdf:type owl:ObjectProperty ;
            owl:inverseOf :teachesCourse ;
            rdfs:domain :Course ;
            rdfs:range :Faculty .


###  http://benchmark/OWL2Bench#isTeachingAssistantOf
:isTeachingAssistantOf rdf:type owl:ObjectProperty ;
                       rdfs:domain :TeachingAssistant ;
                       rdfs:range :Course .


###  http://benchmark/OWL2Bench#isVisitingProfessorOf
:isVisitingProfessorOf rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf :isProfessorOf .


###  http://benchmark/OWL2Bench#isWomenCollegeOf
:isWomenCollegeOf rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf :isCollegeOf .


###  http://benchmark/OWL2Bench#likes
:likes rdf:type owl:ObjectProperty ,
                owl:IrreflexiveProperty ;
       rdfs:domain :Person ;
       rdfs:range :Interest .


###  http://benchmark/OWL2Bench#loves
:loves rdf:type owl:ObjectProperty ;
       rdfs:subPropertyOf :likes ;
       rdfs:domain :Person ;
       rdfs:range :Interest .


###  http://benchmark/OWL2Bench#offerCourse
:offerCourse rdf:type owl:ObjectProperty ;
             rdfs:domain :Department ;
             rdfs:range :Course .


###  http://benchmark/OWL2Bench#orgPublication
:orgPublication rdf:type owl:ObjectProperty ;
                rdfs:domain :Organization ;
                rdfs:range :Publication ;
                rdfs:comment "publishes" .


###  http://benchmark/OWL2Bench#publicationResearch
:publicationResearch rdf:type owl:ObjectProperty ;
                     rdfs:domain :Publication ;
                     rdfs:comment "is about" .


###  http://benchmark/OWL2Bench#takesCourse
:takesCourse rdf:type owl:ObjectProperty ;
             rdfs:domain :Student ;
             rdfs:range :Course .


###  http://benchmark/OWL2Bench#teachesCourse
:teachesCourse rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :hasWork ;
               rdfs:domain :Faculty ;
               rdfs:range :Course .


###  http://benchmark/OWL2Bench#tenured
:tenured rdf:type owl:ObjectProperty ;
         rdfs:domain :Professor .


###  http://benchmark/OWL2Bench#worksFor
:worksFor rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf :isMemberOf ;
          rdfs:domain :Employee ;
          rdfs:range :Organization .


