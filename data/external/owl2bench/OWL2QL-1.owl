###  http://benchmark/OWL2Bench#BasketBallFan
:BasketBallFan rdf:type owl:Class ;
               rdfs:subClassOf [ owl:intersectionOf ( :Person
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :isCrazyAbout ;
                                                        owl:someValuesFrom :BasketBall
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] .


###  http://benchmark/OWL2Bench#BasketBallLover
:BasketBallLover rdf:type owl:Class ;
                 rdfs:subClassOf [ owl:intersectionOf ( :Person
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :loves ;
                                                          owl:someValuesFrom :BasketBall
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] .


