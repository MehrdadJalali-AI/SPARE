:ThesisEvaluationCommittee rdf:type owl:Class ;
                           rdfs:subClassOf :StudentEvaluationCommittee ;
                           rdfs:comment "Evaluates PhD students" .


###  http://benchmark/OWL2Bench#Travelling
:Travelling rdf:type owl:Class ;
            rdfs:subClassOf :Interest .


###  http://benchmark/OWL2Bench#UGCourse
:UGCourse rdf:type owl:Class ;
          rdfs:subClassOf :Course ;
          rdfs:comment "Mandatory courses for all UG students" .


###  http://benchmark/OWL2Bench#UGProgram
:UGProgram rdf:type owl:Class ;
           rdfs:subClassOf :Program .


###  http://benchmark/OWL2Bench#UGStudent
:UGStudent rdf:type owl:Class ;
           rdfs:subClassOf [ owl:intersectionOf ( :Student
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty :enrollFor ;
                                                    owl:someValuesFrom :UGProgram
                                                  ]
                                                ) ;
                             rdf:type owl:Class
                           ] .


